<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Java Interview Practice</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <div class="app-shell">
    <header class="top-bar">
      <h1>Java Interview Practice</h1>
      <div class="top-controls">
        <input id="user-id" type="text" value="guest" aria-label="user">
        <% if (availableProviders.length > 0) { %>
        <select id="provider" aria-label="provider">
          <% availableProviders.forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }); %>
        </select>
        <% } %>
      </div>
    </header>
    <main id="app"></main>
  </div>
  <script>
    window.__INITIAL_STATE__ = <%- initialStateJson %>;
  </script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/public/codemirror-bundle.js"></script>
  <script src="/public/app.js"></script>
</body>
</html>
